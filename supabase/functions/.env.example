# Copy to .env for local Supabase functions; remote configuration uses Dashboard Secrets.
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080
# Email transacional (SMTP do SendPulse) — convites de responsáveis.
# Porta 2525 ou 465 (as Edge Functions bloqueiam 25 e 587).
SEND_PULSE_SMPT=smtp-pulse.com
SEND_PULSE_PORT=2525
SEND_PULSE_USER=
SEND_PULSE_PW=
# Remetente verificado no SendPulse (por omissão usa SEND_PULSE_USER).
EMAIL_FROM_ADDRESS=nao-responder@escolaemdia.me
EMAIL_FROM_NAME=Escola em Dia
# Link do email de convite (staging/dev podem apontar para outro endereço).
INVITE_BASE_URL=https://app.escolaemdia.me/convite
