{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Android (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android",
      "flutterMode": "debug"
    },
    {
      "name": "Android (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android",
      "flutterMode": "profile"
    },
    {
      "name": "Web (Chrome :8081)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=8081"]
    }
  ]
}
